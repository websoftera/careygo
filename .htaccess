# ============================================================
# Careygo — Apache Configuration
# ============================================================

Options -Indexes -MultiViews
ServerSignature Off

# ── Error documents ──────────────────────────────────────────
# These paths are relative to the server root. On a subdomain (prod) the app
# is at /, so use /404.php. On localhost with a subfolder, Apache rewrites
# ErrorDocument paths relative to the vhost root, so /404.php still works
# because Apache maps it to the site root. Adjust if your host differs.
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 403 /404.php

# ── Environment overrides (uncomment & set on production) ────
# SetEnv CGO_SITE_URL    https://careygo.in
# SetEnv CGO_JWT_SECRET  your-long-random-secret-here
# SetEnv CGO_DB_HOST     localhost
# SetEnv CGO_DB_USER     your_database_user
# SetEnv CGO_DB_PASS     your_database_password
# SetEnv CGO_DB_NAME     your_database_name

# ── Force HTTPS (uncomment on live server) ───────────────────
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Rewrite engine (needed for clean redirects) ──────────────
RewriteEngine On

# Block web requests for application internals, repository metadata, and
# maintenance utilities. PHP can still include these files internally.
RewriteRule ^(?:config|lib|database|scratch|vendor|\.git|\.github)(?:/|$) - [F,L,NC]
RewriteRule ^(?:debug-[^/]*|test-[^/]*|api_test|check_pricing|diagnosis|dtdc_test|import_pricing|setup(?:-production)?|view_logs)\.php$ - [F,L,NC]

# Never execute an uploaded script, even if a malicious upload is given a PHP
# extension. Image files in this directory continue to be served normally.
RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|php[0-9]?s)$ - [F,L,NC]

# Clean blog URLs
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([A-Za-z0-9-]+)/?$ blog-detail.php?slug=$1 [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Strict-Transport-Security — enable on HTTPS only
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Deny direct downloads of secrets and server-side artifacts ────────────
# Supports both Apache 2.4+ and older Apache access-control syntax.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|composer\.(?:json|lock)|.*\.(?:sql|log|ini|bak|dist|sh|py|pem|key))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Cache static assets ──────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 month"
    ExpiresByType image/gif                 "access plus 1 month"
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
</IfModule>

# ── Compress output ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
