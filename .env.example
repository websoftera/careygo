# ============================================================
# CAREYGO CONFIGURATION FILE
# ============================================================
# Copy this file to .env and update with your values
# Then require it in your config files

# ── DATABASE ──────────────────────────────────────────────
CGO_DB_HOST=localhost
CGO_DB_USER=your_database_user
CGO_DB_PASS=your_database_password
CGO_DB_NAME=your_database_name

# ── JWT & SECURITY ────────────────────────────────────────
CGO_JWT_SECRET=replace-with-a-long-random-secret
CGO_JWT_EXPIRY=28800
CGO_SITE_URL=https://careygo.in
CGO_SITE_HOST=careygo.in
CGO_ADMIN_EMAIL=your-admin-email@example.com

# ── EMAIL CONFIGURATION ───────────────────────────────────
# Choose one: 'php-mail' (default) or 'smtp'
CGO_EMAIL_METHOD=php-mail

CGO_EMAIL_FROM=noreply@careygo.in
CGO_EMAIL_REPLY=support@careygo.in

# ── SMTP SETTINGS (if using CGO_EMAIL_METHOD=smtp) ────────
# Enable SMTP (set to 1 to enable)
SMTP_ENABLED=0

# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls

# SMTP Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Example configurations for popular services:
# ────────────────────────────────────────────
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-app-specific-password (from Google Account)
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxx (your SendGrid API key)
#
# AWS SES:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com (your region)
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=your-ses-user
#   SMTP_PASS=your-ses-password
#
# Outlook/Office365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=your-email@outlook.com
#   SMTP_PASS=your-password
#
# Mailgun:
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=postmaster@your-domain.mailgun.org
#   SMTP_PASS=your-mailgun-password

# ── DTDC TRACKING API CREDENTIALS ─────────────────────────
# Get these from your DTDC account portal (API Management section)
DTDC_USERNAME=your_dtdc_username
DTDC_PASSWORD=your_dtdc_password
DTDC_API_KEY=your_dtdc_api_key
DTDC_CUSTOMER_CODE=your_customer_code
